# Copy to .env.local and fill in. Only VITE_-prefixed vars reach the browser — never put secrets here.
VITE_CONTACT_ENDPOINT=

# Analytics (optional, production builds only). Unset = not loaded.
# GA4 measurement ID (G-XXXXXXXXXX) and Meta Pixel ID (digits). See scripts/vite-plugin-analytics.ts.
VITE_GA_MEASUREMENT_ID=
VITE_META_PIXEL_ID=
